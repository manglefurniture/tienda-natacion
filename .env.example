APP_ENV=production
APP_URL=https://tienda.hnatacion.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hache_tienda
DB_USERNAME=hache_tienda_app
DB_PASSWORD=CAMBIAR_EN_SERVIDOR

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERAR_EN_SERVIDOR
UPLOAD_DIR=/var/www/tienda.hnatacion.com/app/public/uploads/productos
UPLOAD_URL=/uploads/productos

# Clave aleatoria larga y estable para cifrar credenciales guardadas desde el panel.
PAYMENT_GATEWAY_CONFIG_KEY=

# Compatibilidad inicial: estas variables siguen funcionando mientras la pasarela
# no se haya guardado desde /admin/pasarelas.php.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_NOTIFICATION_FROM=notificaciones@hnatacion.com
ORDER_NOTIFICATION_FROM_NAME=Hache Natación Tienda
